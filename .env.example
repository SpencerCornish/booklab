# ── Production (VPS) ─────────────────────────────────────────────────────────
#   cp .env.example .env   # then edit this file
#   docker compose -f docker-compose.prod.yml up -d --build
# Postgres has no public port; SMTP/Stripe/APP_URL come from .env below.

# Database (Go on the host talks to Docker Postgres via published port)
# The password in DATABASE_URL must match POSTGRES_PASSWORD.
# Postgres only reads POSTGRES_PASSWORD on first volume init; if you change it
# afterward, run `make db-reset` or `docker compose down -v` then `make db`.
DATABASE_URL=postgres://booklab:booklab@localhost:5432/booklab?sslmode=disable
POSTGRES_PASSWORD=booklab
# If port 5432 is already taken on your machine, set e.g. POSTGRES_HOST_PORT=5433
# and point DATABASE_URL at localhost:5433 instead.
POSTGRES_HOST_PORT=5432

# Production (docker-compose.prod.yml): host port for the app container (default 8080).
# APP_PUBLISH_PORT=8080
# Postgres data directory on the host (bind mount; path is relative to the compose file).
# POSTGRES_DATA_PATH=./data/postgres

# Admin bootstrap (first run only; unset after initial setup)
ADMIN_USER=admin
ADMIN_PASS=change-me

# Server
PORT=8080

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Publishable key: used at Docker image build time (docker compose / Dockerfile build args).
# Also set in web/.env for local Vite dev (see web/.env.example).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# SMTP — local dev: use Mailpit (make mailpit), then view emails at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BookLab <noreply@localhost>
# Production: replace with real SMTP credentials

# App (use your public HTTPS URL in production, e.g. https://book.example.com)
APP_URL=http://localhost:8080
# Comma-separated browser origins allowed for credentialed CORS (defaults to APP_URL if unset).
# Example local dev with Vite: APP_URL=http://localhost:8080 and CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
# CORS_ALLOWED_ORIGINS=
