# Database
DATABASE_URL=postgres://booklab:booklab@localhost:5432/booklab?sslmode=disable
POSTGRES_PASSWORD=booklab

# Admin bootstrap (first run only; unset after initial setup)
ADMIN_USER=admin
ADMIN_PASS=changeme

# Server
PORT=8080

# Stripe
STRIPE_SECRET_KEY=sk_test_...
# Frontend (also set VITE_STRIPE_PUBLISHABLE_KEY in web/.env)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# SMTP — Mailpit when running `make db` or `make mailpit` (inbox UI http://localhost:8025)
# For production use an SMTP provider such as Resend:
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=re_...
#   SMTP_FROM must be a bare email address (no display name): noreply@yourdomain.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost

# App (local: API + embedded SPA on PORT; add Vite's origin to CORS when using `pnpm dev` in web/)
APP_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
