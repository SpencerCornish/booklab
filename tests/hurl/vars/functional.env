# Variables for the Hurl API functional suites (tests/hurl/suites).
# Override any of these per-run with `--variable name=value`.
#
# Ports must match tests/scripts/lib.sh defaults (or the overrides used).

base_url=http://localhost:8090
mailpit_url=http://localhost:8027

admin_user=admin
admin_pass=functest-admin-pass

# Fixed far-future date, inside default bookable hours (09:00-21:00
# America/Denver, UTC-6 on 2030-03-15) so results never depend on "now".
booking_date=2030-03-15
other_date=2030-03-20
booking_start=2030-03-15T10:00:00-06:00
booking_end=2030-03-15T12:00:00-06:00
extended_end=2030-03-15T13:00:00-06:00
next_start=2030-03-15T13:00:00-06:00
next_end=2030-03-15T14:00:00-06:00

customer_email=booker.functest@example.com
customer_name=Functional Test Booker
email_flow_email=flow.functest@example.com
email_flow_name=Email Flow Booker

unknown_token=00000000-0000-0000-0000-000000000000